      <rules>
        <rule id="9995-e7d2-208e-471b" name="Horn of Decay" hidden="false">
          <description>You need to make a successful RS test to use the Horn of Decay – treat it as a shooting attack. All enemy models within 18” must take a Fear (1) test.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="cfd5-5fc2-39bc-fe4e" name="Immune to Fear" hidden="false" targetId="437c-d4ed-ab37-e1c4" type="rule"/>
