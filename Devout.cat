      </constraints>
      <rules>
        <rule id="aa9f-0fd1-3041-5606" name="Warlord" hidden="false">
          <description>• If your Warlord dies all friendly Units within 8” must make a Panic Test (unless they are Immune to Panic).
• Every friendly Unit 8” from the Warlord may use his LD for Psychology Tests.</description>
        </rule>
      </rules>
